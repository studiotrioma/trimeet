{
  "name": "trimeet",
  "version": "8.0.0",
  "description": "Compartilhamento de tela entre amigos",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "author": "Levi",
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "electron": "45.3.3",
    "electron-builder": "^25.1.8"
  },
  "productName": "TriMeet",
  "build": {
    "appId": "com.levi.trimeet",
    "productName": "TriMeet",
    "files": [
      "main.js",
      "core/**",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "TriMeet",
      "artifactName": "TriMeet-Instalador-8.0.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "TriMeet-Portatil-8.0.exe"
    },
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ],
    "compression": "maximum",
    "afterPack": "./afterPack.js"
  }
}